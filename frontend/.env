# Backend API base URL. In development this is proxied to the FastAPI server
# (see vite.config.js), so a relative "/api" is recommended and avoids CORS issues.
# For production set the full URL, e.g. VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=/api

# Google OAuth client ID for "Sign in with Google".
# Leave empty to keep Google sign-in disabled. Set to your Google Cloud OAuth client ID.
VITE_GOOGLE_CLIENT_ID=

# ============================================================================
# Firebase (Web App) configuration - powers the "Continue with Google" button.
# Copy these EXACT values from your Firebase console:
#   Firebase Console > Project Settings > General > Your apps > SDK setup and
#   configuration > "Config" (the firebaseConfig object).
# These are public web-app identifiers, safe to expose in the frontend bundle.
# Fill every line below; while they are blank Google sign-in stays disabled.
# ============================================================================
VITE_FIREBASE_API_KEY="AIzaSyDpP4ByYAZelWD-IQC1k-U2If_D5R9DrmE"
VITE_FIREBASE_AUTH_DOMAIN="govtguide-ai-452e2.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="govtguide-ai-452e2"
VITE_FIREBASE_STORAGE_BUCKET="govtguide-ai-452e2.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="938732348977"
VITE_FIREBASE_APP_ID="1:938732348977:web:237ac9fd82e93da2bb9710"
# Optional (only if you enabled Analytics):
VITE_FIREBASE_MEASUREMENT_ID="G-TM4X3RTYLX"
