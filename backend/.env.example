# ============================================================
# GovGuide AI - Backend Environment Template
# Copy to `.env` for local development. NEVER commit real secrets.
# ============================================================

# Runtime: development | production
ENVIRONMENT=development

# Data store configuration
# By default all app data is served from the bundled local JSON file database
# (backend/data/local_db.json). Set DATABASE_URL below to persist everything to
# PostgreSQL / Neon instead.
DB_NAME=govguide_db

# ============================================================
# Hybrid Verified-Scheme Store (Optional - Supabase Postgres)
# ============================================================
# The normalized scheme catalogue + search can live in a Supabase/PostgreSQL
# database while all user/app data stays in the local JSON file database. If
# this is empty, or the server is unreachable, the scheme store transparently
# falls back to the JSON file database above - the app NEVER breaks without
# Postgres.
#
# Use the Supabase "Connection string" (Project Settings -> Database ->
# Connection string -> URI). Prefer the direct connection for local dev, or the
# session pooler (port 5432). NEVER commit this secret.
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Primary Postgres / Neon connection string.
# When this is set and reachable the WHOLE application persists to PostgreSQL:
# every collection (users, profiles, schemes, saved_schemes, conversations,
# notifications, applications, family_members, app_readiness, cert_reminders,
# workspace_notes, calendar_events, ...) gets its own gg_* table in the public
# schema, and get_db() serves Postgres instead of the local JSON file.
# When it is empty or unreachable the app keeps using backend/data/local_db.json,
# so it never breaks - but nothing is then stored in PostgreSQL.
#
# Paste the Neon URI from the Neon Console (Project GovtGuideAI -> Dashboard ->
# Connection Details). Keep the '?sslmode=require' suffix: Neon only accepts TLS
# and the backend converts it into a verified TLS context for the asyncpg driver
# (asyncpg itself has no 'sslmode' keyword). NEVER commit this secret.
#   postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
#
# Create / verify the schema and import the existing JSON data (safe to re-run,
# it never drops or deletes anything):
#   python setup_database.py           # connect + create tables + import data
#   python setup_database.py --test    # also runs an insert/read round trip
DATABASE_URL=postgresql://neondb_owner:npg_p1WSdx7ejaEQ@ep-winter-glade-b3cpnvbx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Set to false to force the app to ignore Postgres and use the JSON file only.
POSTGRES_ENABLED=true

# JWT Configuration
# IMPORTANT: set a long random value in production.
JWT_SECRET=supersecretkeychangeinproduction12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Optional - chatbot language explanations)
# Get a key from: https://makersuite.google.com/app/apikey
# Leave empty to use the built-in code-based (deterministic) fallback.
GEMINI_API_KEY=
# Gemini model used by the chatbot. Set to a model your account supports,
# e.g. gemini-3-flash-preview (currently served), gemini-2.5-pro, gemini-flash-latest.
GEMINI_MODEL=gemini-3-flash-preview

# External scheme-discovery agent/webhook (Optional)
# Leave empty to disable external agent calls; the local verified DB stays the source of truth.
DISCOVERY_WEBHOOK_URL=

# Google OAuth (Optional - enables "Sign in with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Firebase Authentication (Optional - enables the frontend "Continue with Google").
# Set this to your Firebase Project ID (the projectId value from your Firebase web
# app config). It is public, NOT a secret. While empty, /api/auth/firebase returns
# 503 and Google sign-in is disabled. Must match VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# CORS: comma-separated list of allowed frontend origins.
# Do NOT set "*" together with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Demo / tokenless authentication (development convenience only).
# Outside development this is IGNORED: when ENVIRONMENT=production demo auth is
# ALWAYS disabled, so a static admin token or a tokenless request can never
# bypass authentication. In development it is on by default; set false to disable.
ALLOW_DEMO_AUTH=false
